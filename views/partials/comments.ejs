<h2>Comments</h2>

<% if (comments.length === 0) { %>
  <p class="comments-empty">No comments yet.</p>
<% } else { %>
  <div class="comment-list" id="comment-list">
    <% comments.forEach(c => { %>
      <div class="comment comment-<%= c.author_role %>">
        <div class="comment-meta">
          <strong><%= c.author_name %></strong>
          <span class="comment-role"><%= c.author_role === 'admin' ? 'Admin' : 'Student' %></span>
          <span class="comment-date"><%= c.created_at.toLocaleString() %></span>
        </div>
        <p class="comment-message"><%= c.message %></p>
      </div>
    <% }) %>
  </div>
<% } %>

<form action="<%= commentActionUrl %>" method="POST" class="comment-form">
  <div class="form-group">
    <label for="message">Add a Comment</label>
    <textarea id="message" name="message" rows="3" maxlength="1000" required oninput="document.getElementById('char-count').textContent = this.value.length"></textarea>
    <div class="char-count"><span id="char-count">0</span>/1000</div>
  </div>
  <button type="submit" class="btn">Post Comment</button>
</form>

<script>
  // If we just posted a comment, scroll to the bottom of the thread
  if (window.location.hash === '#comment-list' || document.referrer.includes('/comments')) {
    const list = document.getElementById('comment-list');
    if (list) list.scrollIntoView({ behavior: 'smooth', block: 'end' });
  }
</script>