<%- include('../partials/header', { title: 'All Complaints' }) %>

<h1>All Complaints</h1>

<form action="/admin/complaints" method="GET" class="filter-form">
  <div class="form-group">
    <label for="search">Search (title)</label>
    <input type="text" id="search" name="search" value="<%= filters.search %>">
  </div>

  <div class="form-group">
    <label for="status">Status</label>
    <select id="status" name="status">
      <option value="">All</option>
      <% ['Submitted', 'Under Review', 'In Progress', 'Resolved'].forEach(s => { %>
        <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </div>

  <div class="form-group">
    <label for="category_id">Category</label>
    <select id="category_id" name="category_id">
      <option value="">All</option>
      <% categories.forEach(cat => { %>
        <option value="<%= cat.id %>" <%= filters.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
      <% }) %>
    </select>
  </div>

  <button type="submit" class="btn">Apply Filters</button>
  <a href="/admin/complaints" class="btn-secondary">Clear Filters</a>
</form>

<p><%= complaints.length %> complaint(s) found.</p>

<% if (complaints.length === 0) { %>
  <div class="empty-state">
    <p>No complaints match your filters. Try adjusting or clearing them above.</p>
  </div>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th><th>Title</th><th>Student</th><th>Category</th><th>Status</th><th>Submitted</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% complaints.forEach(c => { %>
        <tr>
          <td data-label="ID">#<%= c.id %></td>
          <td data-label="Title"><%= c.title %></td>
          <td data-label="Student"><%= c.student_name %></td>
          <td data-label="Category"><%= c.category_name %></td>
          <td data-label="Status">
            <span class="status-badge status-<%= c.status.toLowerCase().replace(/ /g, '-') %>">
              <%= c.status %>
            </span>
          </td>
          <td data-label="Submitted"><%= c.created_at.toLocaleDateString() %></td>
          <td data-label=""><a href="/admin/complaints/<%= c.id %>">View</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>