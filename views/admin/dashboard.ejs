<%- include('../partials/header', { title: 'Admin Dashboard' }) %>

<h1>Admin Dashboard</h1>
<p>
  Logged in as <%= user.full_name %>
  <% if (isSuperAdmin) { %>
    <span class="dept-badge dept-super">Super Admin</span>
  <% } else { %>
    <span class="dept-badge"><%= user.department %></span>
  <% } %>
</p>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-number"><%= counts.Submitted || 0 %></div>
    <div>Submitted</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= counts['Under Review'] || 0 %></div>
    <div>Under Review</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= counts['In Progress'] || 0 %></div>
    <div>In Progress</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= counts.Resolved || 0 %></div>
    <div>Resolved</div>
  </div>
</div>

<p><a href="/admin/complaints" class="btn">View All Complaints</a></p>

<h2>Most Recent Complaints</h2>
<% if (recentComplaints.length === 0) { %>
  <p>No complaints yet.</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>ID</th><th>Title</th><th>Student</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
      <% recentComplaints.forEach(c => { %>
        <tr>
          <td data-label="ID">#<%= c.id %></td>
          <td data-label="Title"><%= c.title %></td>
          <td data-label="Student"><%= c.student_name %></td>
          <td data-label="Status">
            <span class="status-badge status-<%= c.status.toLowerCase().replace(/ /g, '-') %>">
              <%= c.status %>
            </span>
          </td>
          <td data-label=""><a href="/admin/complaints/<%= c.id %>">View</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>