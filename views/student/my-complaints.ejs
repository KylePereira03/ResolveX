<%- include('../partials/header', { title: 'My Complaints' }) %>

<h1>My Complaints</h1>

<% if (complaints.length === 0) { %>
  <p>You haven't submitted any complaints yet. <a href="/student/complaints/new">Submit one now</a>.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Category</th>
        <th>Status</th>
        <th>Submitted</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% complaints.forEach(c => { %>
        <tr>
          <td data-label="ID">#<%= c.id %></td>
          <td data-label="Title"><%= c.title %></td>
          <td data-label="Category"><%= c.category_name %></td>
          <td data-label="Status">
            <span class="status-badge status-<%= c.status.toLowerCase().replace(/ /g, '-') %>">
              <%= c.status %>
            </span>
          </td>
          <td data-label="Submitted"><%= c.created_at.toLocaleDateString() %></td>
          <td data-label=""><a href="/student/complaints/<%= c.id %>">View</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>