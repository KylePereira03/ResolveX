<%- include('../partials/header', { title: 'Student Dashboard' }) %>

<h1>Welcome, <%= user.full_name %></h1>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-number"><%= counts.Submitted || 0 %></div>
    <div>Submitted</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= counts['Under Review'] || 0 %></div>
    <div>Under Review</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= counts['In Progress'] || 0 %></div>
    <div>In Progress</div>
  </div>
  <div class="stat-card">
    <div class="stat-number"><%= counts.Resolved || 0 %></div>
    <div>Resolved</div>
  </div>
</div>

<p><a href="/student/complaints/new" class="btn">Submit a New Complaint</a></p>

<h2>Recent Complaints</h2>
<% if (recentComplaints.length === 0) { %>
  <p>No complaints yet.</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>ID</th><th>Title</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
      <% recentComplaints.forEach(c => { %>
        <tr>
          <td data-label="ID">#<%= c.id %></td>
          <td data-label="Title"><%= c.title %></td>
          <td data-label="Status">
            <span class="status-badge status-<%= c.status.toLowerCase().replace(/ /g, '-') %>">
              <%= c.status %>
            </span>
          </td>
          <td data-label=""><a href="/student/complaints/<%= c.id %>">View</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <p><a href="/student/complaints">View all my complaints</a></p>
<% } %>

<%- include('../partials/footer') %>