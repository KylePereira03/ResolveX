<%- include('../partials/header', { title: 'Complaint #' + complaint.id, user: user, activeNav: 'my-complaints' }) %>

<% if (typeof submitted !== 'undefined' && submitted) { %>
  <div class="alert alert-success">Your complaint was submitted successfully.</div>
<% } %>

<h1><%= complaint.title %></h1>
<p class="page-sub">
  <span class="status-badge status-<%= complaint.status.toLowerCase().replace(/ /g, '-') %>">
    <%= complaint.status %>
  </span>
</p>

<div class="panel">
  <div class="panel-header">
    <h2>Details</h2>
  </div>
  <table class="detail-table">
    <tr><th>Complaint ID</th><td class="mono">#<%= complaint.id %></td></tr>
    <tr><th>Category</th><td><%= complaint.category_name %></td></tr>
    <tr><th>Description</th><td><%= complaint.description %></td></tr>
    <tr>
      <th>Attachment</th>
      <td>
        <% if (complaint.attachment_path) { %>
          <a href="/student/complaints/<%= complaint.id %>/attachment"><%= complaint.attachment_original_name %></a>
        <% } else { %>
          No attachment.
        <% } %>
      </td>
    </tr>
    <tr><th>Submitted</th><td class="mono"><%= complaint.created_at.toLocaleString() %></td></tr>
    <tr><th>Last Updated</th><td class="mono"><%= complaint.updated_at.toLocaleString() %></td></tr>
    <tr><th>Admin Response</th><td><%= complaint.admin_response || 'No response yet.' %></td></tr>
  </table>
</div>

<%- include('../partials/comments', { comments: comments, commentActionUrl: `/student/complaints/${complaint.id}/comments` }) %>

<p><a href="/student/complaints" class="btn-secondary">Back to My Complaints</a></p>

<%- include('../partials/footer') %>