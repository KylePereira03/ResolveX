<%- include('../partials/header', { title: 'Admin Login' }) %>
<%- include('../partials/messages', { message: typeof message !== 'undefined' ? message : null }) %>

<h1>Admin Login</h1>

<form action="/admin/login" method="POST">
  <div class="form-group">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= typeof formData !== 'undefined' ? formData.email : '' %>" required>
  </div>

  <div class="form-group">
    <label for="password">Password</label>
    <input type="password" id="password" name="password" required>
  </div>

  <button type="submit" class="btn">Login as Admin</button>
</form>

<%- include('../partials/footer') %>